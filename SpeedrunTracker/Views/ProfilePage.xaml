<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SpeedrunTracker.Controls"
             xmlns:loc="clr-namespace:SpeedrunTracker.Localization"
             xmlns:viewmodels="clr-namespace:SpeedrunTracker.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodels:ProfileViewModel"
             x:Class="SpeedrunTracker.Views.ProfilePage"
             x:Name="ProfilePageName"
             Title="{loc:Translate MenuItemProfileTitle}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding InitializeCommand}"
                                        BindingContext="{Binding Path=BindingContext, Source={x:Reference ProfilePageName}, x:DataType=ContentPage}"
                                        EventName="Loaded" />
    </ContentPage.Behaviors>
    <VerticalStackLayout>
        <Grid RowDefinitions="3*,*">
            <VerticalStackLayout VerticalOptions="Center"
                                 Grid.Row="0"
                                 Margin="0,50,0,0">
                <controls:AvatarControl ImageSource="{Binding ImageUri}"
                                        AvatarSize="150"
                                        Command="{Binding NavigateToUserCommand}" />
                <Label Text="{Binding Name}"
                       TextColor="{Binding User.NameStyle.ThemeColor}"
                       FontSize="Large"
                       HorizontalOptions="Center"
                       Padding="10" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Margin="0,40,0,0">
                <Label Text="{loc:Translate ProfilePageEnterApiKeyLabel}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}" />
                <Entry x:Name="_apiKeyEntry"
                       Placeholder="{loc:Translate ProfilePageApiKeyLabel}"
                       IsPassword="True"
                       HorizontalOptions="Center"
                       WidthRequest="300"
                       Margin="20"
                       Text="{Binding ApiKey, Mode=TwoWay}"
                       IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}" />
                <Button Text="{loc:Translate ProfilePageLoginTitle}"
                        HorizontalOptions="Center"
                        WidthRequest="100"
                        IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBoolConverter}}"
                        Command="{Binding LoginCommand}"
                        Clicked="Button_Clicked" />
                <Button Text="{loc:Translate ProfilePageLogoutTitle}"
                        HorizontalOptions="Center"
                        WidthRequest="100"
                        IsVisible="{Binding IsLoggedIn}"
                        Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentPage>