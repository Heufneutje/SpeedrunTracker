<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SpeedrunTracker.Localization"
             xmlns:sv="clr-namespace:AiForms.Settings;assembly=SettingsView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:SpeedrunTracker.ViewModels"
             x:Name="SettingsPageName"
             x:DataType="viewmodels:SettingsViewModel"
             x:Class="SpeedrunTracker.Views.SettingsPage"
             Title="{loc:Translate MenuItemSettingsTitle}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior Command="{Binding SaveChangesCommand}"
                                        BindingContext="{Binding Path=BindingContext, Source={x:Reference SettingsPageName}, x:DataType=ContentPage}"
                                        EventName="Disappearing" />
    </ContentPage.Behaviors>
    <sv:SettingsView x:Name="settingsView">
        <sv:Section Title="{loc:Translate SettingsPageInterfaceGroupHeader}">
            <sv:PickerCell Title="{loc:Translate SettingsPageThemeItem}"
                           SelectedItem="{Binding Theme}"
                           ItemsSource="{Binding Themes}"
                           SelectionMode="Single"
                           UsePickToClose="True"
                           AccentColor="{StaticResource LightHighlight}"
                           x:Name="themeCell"/>
            <sv:PickerCell Title="{loc:Translate SettingsPageLanguageItem}"
                           SelectedItem="{Binding AppLanguage}"
                           ItemsSource="{Binding LanguageSettings}"
                           SelectionMode="Single"
                           UsePickToClose="True"
                           AccentColor="{StaticResource LightHighlight}" />
            <sv:SwitchCell Title="{loc:Translate SettingsPageBackgroundsItem}"
                           On="{Binding DisplayBackgrounds}"
                           AccentColor="{StaticResource LightHighlight}" />
        </sv:Section>
        <sv:Section Title="{loc:Translate SettingsPageDateTimeGroupHeader}">
            <sv:PickerCell Title="{loc:Translate SettingsPageDateFormatItem}"
                           SelectedItem="{Binding DateFormat}"
                           ItemsSource="{Binding DateFormats}"
                           SelectionMode="Single"
                           UsePickToClose="True"
                           AccentColor="{StaticResource LightHighlight}" />
            <sv:PickerCell Title="{loc:Translate SettingePageTimeFormatItem}"
                           SelectedItem="{Binding TimeFormat}"
                           ItemsSource="{Binding TimeFormats}"
                           SelectionMode="Single"
                           UsePickToClose="True"
                           AccentColor="{StaticResource LightHighlight}" />
        </sv:Section>
        <sv:Section Title="{loc:Translate SettingsPageLeadboardGroupHeader}">
            <sv:TextPickerCell Title="{loc:Translate SettingsPageMaximumLeaderboardResultsItem}"
                               PickerTitle="{loc:Translate SettingsPageMaximumLeaderboardResultsItem}"
                               SelectedItem="{Binding MaxLeaderboardResults}"
                               Items="{Binding LeaderboardResultsOptions}"
                               AccentColor="{StaticResource LightHighlight}"
                               IsCircularPicker="False" />
        </sv:Section>
    </sv:SettingsView>
</ContentPage>
